  <PropertyGroup Label="UserMacros">
    <!-- Anchored to this file, not to the working directory, so the paths below mean the
         same thing however MSBuild is invoked: from the repo root, from here, or from the
         solution. Same definition as ida-capa.vcxproj. -->
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
  </PropertyGroup>
  <!-- Everything this project produces, final or intermediate, under the repo's one
       build\ directory. Both halves of that are deliberate:
         - one OutDir for every configuration, rather than a per-config path that drifted.
           Debug used to resolve to capa-cpp\build\Debug\ and Release to build\Release\,
           because RepoRoot was never defined and only one of the two compensated.
         - IntDir moved off its default of $(Platform)\$(Configuration)\, which put .obj
           files (and, before OutDir existed, the .exe itself) inside the source tree at
           capa-cpp\x64\. A stale binary left there is the expensive kind of mistake:
           it runs, and it is not the code you just built.
       Deleting build\ therefore removes every artifact, which is what `build.sh clean`
       does. x64 only; the Win32 configurations have no dependencies wired and are unused,
       and are left on the MSBuild defaults rather than sharing these paths. -->
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <OutDir>$(RepoRoot)build\$(Configuration)\</OutDir>
    <IntDir>$(RepoRoot)build\$(Configuration)\obj\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>
