<?xml version="1.0" encoding="utf-8"?>
<!--
  capa-core: the backend-independent capa engine as a static library.

  Rules in, features in (from any extractor, or from a freeze file), result document out.
  It links no analysis backend (no Zydis, no TTD reader, no IDA SDK), so it can be
  embedded anywhere: capa-cpp.exe and capa-tests.exe link this library; the IDA plugin
  compiles the same sources itself, because it needs the dynamic CRT (/MD) where the
  executables use the static one (/MT).

  Dependencies (nlohmann-json, yaml-cpp, zlib) come from capa-cpp's vcpkg manifest
  install; see README.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{8c0e6a5e-3f0b-4b8e-9a51-6c2f1d7e4a10}</ProjectGuid>
    <RootNamespace>capacore</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Label="UserMacros">
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <VcpkgInstalledDir>$(RepoRoot)capa-cpp\vcpkg_installed\x64-windows-static</VcpkgInstalledDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <!-- Under the repo's one build\ directory, like every other project here. -->
  <PropertyGroup>
    <OutDir>$(RepoRoot)build\$(Configuration)\</OutDir>
    <IntDir>$(RepoRoot)build\$(Configuration)\obj\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)src;$(VcpkgInstalledDir)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- com_database.cpp is one large generated table -->
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="src\address.h" />
    <ClInclude Include="src\capabilities.h" />
    <ClInclude Include="src\com_database.h" />
    <ClInclude Include="src\engine.h" />
    <ClInclude Include="src\feature.h" />
    <ClInclude Include="src\feature_extractor.h" />
    <ClInclude Include="src\feature_filter.h" />
    <ClInclude Include="src\freeze.h" />
    <ClInclude Include="src\match_retention.h" />
    <ClInclude Include="src\null_extractor.h" />
    <ClInclude Include="src\pyregex.h" />
    <ClInclude Include="src\render.h" />
    <ClInclude Include="src\render_tree.h" />
    <ClInclude Include="src\result_document.h" />
    <ClInclude Include="src\rules.h" />
    <ClInclude Include="src\static_caps.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\address.cpp" />
    <ClCompile Include="src\capabilities.cpp" />
    <ClCompile Include="src\com_database.cpp" />
    <ClCompile Include="src\com_lookup.cpp" />
    <ClCompile Include="src\engine.cpp" />
    <ClCompile Include="src\feature.cpp" />
    <ClCompile Include="src\feature_filter.cpp" />
    <ClCompile Include="src\freeze.cpp" />
    <ClCompile Include="src\match_retention.cpp" />
    <ClCompile Include="src\null_extractor.cpp" />
    <ClCompile Include="src\pyregex.cpp" />
    <ClCompile Include="src\render.cpp" />
    <ClCompile Include="src\render_tree.cpp" />
    <ClCompile Include="src\result_document.cpp" />
    <ClCompile Include="src\rules.cpp" />
    <ClCompile Include="src\static_caps.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
